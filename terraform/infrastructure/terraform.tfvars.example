cloud_id  = "b1gXXXXXXXXXXXXXXXXX"
folder_id = "b1gYYYYYYYYYYYYYYYYY"

zones                = ["ru-central1-a", "ru-central1-b", "ru-central1-d"]
cluster_version      = "1.31"
name_prefix          = "diplom"
network_cidr         = "10.10.0.0/16"
subnet_prefix_length = 24

# Параметры узлов подобраны под ограниченный бюджет: прерываемые виртуальные
# машины с частичной загрузкой процессора.
node_platform_id   = "standard-v3"
node_cores         = 2
node_memory        = 4
node_core_fraction = 50
node_disk_size     = 32
node_count         = 3
node_max_count     = 6

ssh_public_key_path = "~/.ssh/yandex.pub"
registry_name       = "diplom-registry"
